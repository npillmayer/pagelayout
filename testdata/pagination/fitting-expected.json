      "expect": {
        "first_output": "ab-",
        "checkpoint": {
          "next_original": "d",
          "carry": "D",
          "post_break": "c"
        },
        "second_output": "cd",
        "unbroken_source": "abcd",
        "replay_discretionary": false,
        "accepted_prefix_changed": false
      }
    },
    {
      "id": "manual-empty-carry",
      "input": {
        "kind": "synthetic-khipu",
        "before": "co",
        "discretionary": {
          "id": "SHY",
          "no_break": "",
          "pre_break": "-",
          "post_break": ""
