      "expect": {
        "first_output": "co-",
        "checkpoint": {
          "next_original": "operate",
          "carry": "SHY",
          "post_break": ""
        },
        "second_output": "operate",
        "carry_identity_preserved_even_when_empty": true,
        "base_reprepare": false
      }
