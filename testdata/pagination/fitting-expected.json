    {
      "id": "manual-nonempty-carry",
      "input": {
        "kind": "synthetic-khipu",
        "before": "a",
        "discretionary": {
          "id": "D",
          "no_break": "bc",
          "pre_break": "b-",
          "post_break": "c"
