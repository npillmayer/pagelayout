{
  "status": "contract-inputs-and-hand-authored-results",
  "units": "CSS pixels",
  "backend": "synthetic; line breaks/ranges are supplied facts, not font measurements",
  "cases": [
    {
      "id": "split-outer-edges",
      "input": {
        "kind": "synthetic-block",
        "lines": [
          "A",
          "B",
          "C",
          "D",
          "E"
        ],
        "line_height_px": 10,
        "top_edges_px": 8,
        "bottom_edges_px": 12,
        "side_edges_px": 6,
        "receivers": [
          [
            100,
            28
          ],
          [
            80,
            20
          ],
          [
            120,
            22
          ]
        ]
      },
      "expect": {
        "fragments": [
          {
            "lines": [
              "A",
              "B"
            ],
            "extent_px": 28,
            "content_width_px": 94,
            "top_edges_px": 8,
            "bottom_edges_px": 0
          },
          {
            "lines": [
              "C",
              "D"
            ],
            "extent_px": 20,
            "content_width_px": 74,
            "top_edges_px": 0,
            "bottom_edges_px": 0
          },
          {
            "lines": [
              "E"
            ],
            "extent_px": 22,
            "content_width_px": 114,
            "top_edges_px": 0,
            "bottom_edges_px": 12
          }
        ],
        "placed_then_remainder": [
          "A",
          "B",
          "C",
          "D",
          "E"
        ],
        "remainder": [],
        "source_style_unchanged": true
      }
    },
    {
      "id": "closing-edges-must-fit",
      "input": {
        "kind": "synthetic-block-tail",
        "remaining_lines": [
          "E"
        ],
        "line_height_px": 10,
        "bottom_edges_px": 12,
        "receiver": [
          120,
          21
        ]
      },
      "expect": {
        "outcome": "NoFit",
        "placed": [],
        "remainder": [
          "E"
        ],
        "bottom_edges_still_pending_px": 12,
        "may_make_edge_only_fragment": false
      }
    },
    {
      "id": "contained-child-edges",
      "input": {
        "kind": "synthetic-block",
        "parent_split": true,
        "wholly_contained_child": {
          "content_height_px": 10,
          "top_edges_px": 3,
          "bottom_edges_px": 3
        },
        "receiver_height_px": 16
      },
      "expect": {
        "child_extent_px": 16,
        "child_top_edges_px": 3,
        "child_bottom_edges_px": 3,
        "omit_child_edges": false
      }
    },
    {
      "id": "head-plus-cursor",
      "input": {
        "kind": "queue",
        "queue": [
          "A",
          "B",
          "C"
        ],
        "placed": [
          "A",
          "B[0:2]"
        ],
        "head_continuation": null
      },
      "expect": {
        "queue": [
          "B",
          "C"
        ],
        "head_identity": "same-B",
        "continuation": "B@2",
        "untouched_channels_unchanged": true,
        "input_queue": [
          "A",
          "B",
          "C"
        ]
      }
    },
