digraph Layout {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.4, ranksep=0.5,
         fontname="Helvetica", fontsize=14];
  node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#64748b",
        fontname="Helvetica", fontsize=12, margin="0.18,0.12"];
  edge [color="#475569", fontname="Helvetica", fontsize=10];
  graph [label="Speculation preserves input; selection publishes a sequence", labelloc=t];
  state [label="Immutable entry State\nFIFO banks + exact head continuations", fillcolor="#dbeafe"];
  a [label="PageAttempt(template A)\nEnumerate and select local arrangement"];
  b [label="PageAttempt(template B)\nEnumerate and select local arrangement"];
  ca [label="Frozen page A + successor A"];
  cb [label="Frozen page B + successor B"];
  round [label="Complete depth round\nRank loss, then template ordinals"];
  beam [label="Unfinished beam\n32 paths by default"];
  best [label="Best complete span\nRetained outside beam", fillcolor="#dcfce7"];
  select [label="Selected span\nAdvanceSpan or explicit Shipout", fillcolor="#dcfce7"];
  state -> a -> ca -> round;
  state -> b -> cb -> round;
  round -> beam [label="reported heuristic width cuts"];
  beam -> round [label="extend through eligible templates"];
  round -> best [label="all related material drained"];
  best -> select [label="successful search completion"];
  { rank=same; a; b; }
  { rank=same; ca; cb; }
}
