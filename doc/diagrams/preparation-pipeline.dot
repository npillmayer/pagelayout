digraph Layout {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.4, ranksep=0.5,
         fontname="Helvetica", fontsize=14];
  node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#64748b",
        fontname="Helvetica", fontsize=12, margin="0.18,0.12"];
  edge [color="#475569", fontname="Helvetica", fontsize=10];
  graph [label="Prepare once; execute under receiving constraints", labelloc=t];
  source [label="Immutable content.Document\nPrivate unsized trees + Box bank"];
  extract [label="Extract GroupInput\nText, styles, paint, policy, atomics, source events"];
  preflight [label="Whole-document Preflight\nValidate policy/services without font work"];
  prepare [label="Prepare each group\nExplicit font and shaping services"];
  pair [label="PreparedSnapshot + PreparationSession\nPublish together after full success", fillcolor="#dbeafe"];
  intrinsic [label="MeasureIntrinsic\nWidth bounds"];
  layout [label="Layout\nComplete subtree at a width"];
  fit [label="Fit\nFinite-height alternatives + exact remainder"];
  output [label="Independent frozen output\nUsable after Close with borrowed fonts live", fillcolor="#dcfce7"];
  source -> extract -> preflight -> prepare -> pair;
  pair -> intrinsic;
  pair -> layout;
  pair -> fit;
  layout -> output;
  fit -> output;
  { rank=same; intrinsic; layout; fit; }
}
