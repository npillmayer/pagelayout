digraph Layout {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.4, ranksep=0.5,
         fontname="Helvetica", fontsize=14];
  node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#64748b",
        fontname="Helvetica", fontsize=12, margin="0.18,0.12"];
  edge [color="#475569", fontname="Helvetica", fontsize=10];
  graph [label="Production responsibilities and service boundaries", labelloc=t];
  caller [label="Caller\nFonts, shaping, eligibility, renderer"];
  root [label="pagelayout\nOwnership, page construction, search, delivery", fillcolor="#dbeafe"];
  content [label="content\nSource, boxes, neutral preparation/fitting"];
  template [label="template\nCSS collection + compiled receivers"];
  bridge [label="preparation/typography\nExplicit backend + frozen paragraphs", fillcolor="#dcfce7"];
  boxes [label="css-box-layout\nNormalization, registers, geometry, fragments"];
  dom [label="w3c-dom\nCSS inspection, source styling, checked values"];
  typography [label="typography / khipu\nReusable paragraphs + exact continuations"];
  caller -> root;
  caller -> bridge [label="injected services"];
  root -> content;
  root -> template;
  bridge -> content [label="implements neutral protocols"];
  bridge -> typography;
  content -> boxes;
  content -> dom;
  template -> boxes;
  template -> dom;
  { rank=same; content; template; bridge; }
}
