digraph Packages {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.35, ranksep=0.7,
         fontname="Helvetica", fontsize=12];
  node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#64748b",
        fontname="Helvetica", fontsize=12, margin="0.18,0.12"];
  edge [color="#475569", fontname="Helvetica", fontsize=10];

  page [label="pagelayout (proposed)\nTemplate catalog; prepared-flow registers\nPage trials, selection and atomic commit",
        fillcolor="#dbeafe", color="#2563eb"];
  dom [label="w3c-dom\nSeparate source styling contexts\nCSSOM and property lookup"];
  boxes [label="css-box-layout\nExisting: boxing, used values, fixed/flow layout\nProposed: geometry-only API; fragment-fit boundary"];
  type [label="typography / paragraph\nPrepare, Trial, assembly and checkpoints\nBounded paragraph continuation"];
  khipu [label="khipu\nReusable material + atomic bindings\nBreak trials, checkpoints and freezing"];
  reference [label="tytui / documentlayout\nExtraction / preparation adapter reference\nBounded flow; not a register engine",
             fillcolor="#fff7ed", color="#b45309"];

  page -> dom [label="source styling"];
  page -> boxes [label="geometry and\nbox sizing"];
  page -> type [label="prepared paragraphs\nand trial fragments"];
  type -> khipu [label="uses"];
  page -> reference [label="study / reuse decision open", style=dashed];
  { rank=same; dom; boxes; type; reference; }
}
