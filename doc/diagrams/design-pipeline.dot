digraph Layout {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.4, ranksep=0.5,
         fontname="Helvetica", fontsize=14];
  node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#64748b",
        fontname="Helvetica", fontsize=12, margin="0.18,0.12"];
  edge [color="#475569", fontname="Helvetica", fontsize=10];
  graph [label="Separate sources, immutable material, selected pages", labelloc=t];
  templates [label="Template HTML + author CSS"];
  content [label="Content HTML + author CSS"];
  catalog [label="template.Load\nCompiled page/frame catalog", fillcolor="#dbeafe"];
  material [label="content.Load\nSource-styled boxes + persistent channel bank", fillcolor="#dbeafe"];
  prep [label="content.Prepare\nImmutable snapshot + serialized session"];
  plan [label="pagelayout.Plan\nOwnership + forced-break spans"];
  search [label="Pagination.Paginate\nPage attempts + pagespan beam search", fillcolor="#dcfce7"];
  selected [label="Selected sequences\nFrozen pages + exact completion/retry state"];
  delivery [label="Sequence.Shipout\nCaller rendering/export", fillcolor="#dcfce7"];
  templates -> catalog;
  content -> material;
  material -> prep;
  material -> plan;
  catalog -> search;
  prep -> search [label="reusable preparation"];
  plan -> search;
  search -> selected -> delivery;
  { rank=same; templates; content; }
  { rank=same; prep; plan; }
}
