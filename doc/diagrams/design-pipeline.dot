digraph Pipeline {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.45, ranksep=0.35,
         fontname="Helvetica", fontsize=12];
  node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#64748b",
        fontname="Helvetica", fontsize=12, margin="0.18,0.12"];
  edge [color="#475569", fontname="Helvetica", fontsize=10];

  collection [label="Parse reusable HTML collection\nIndex template IDs; retain source context"];
  sheets [label="Collect head CSS once\nOrdered, read-only sheets"];
  instantiate [label="Select and clone one page\nFresh html/head/body context"];
  style [label="Fresh w3c-dom CSSOM per instance\nRegister sheets at nil scope\nStyle the active document"];
  validate [label="Validate structure and effective CSS\nDirect fixed frames; definite sizes\nProposed initial profile"];
  fixed [label="Typed projection + BuildLayoutTrees\nFixedLayout with empty-frame callback\nViewport = resolved page dimensions"];
  check [label="Check resolved border/content rectangles\nPositive; within page; no overlaps\nProposed initial policy"];
  compiled [label="Proposed compiled page description\nPage paint; frame/content rectangles\nFlow names; source order; source identities",
            fillcolor="#dbeafe", color="#2563eb"];
  content [label="Separate HTML content + CSS\nSource styles and named flows"];
  flow [label="Flow material into content rectangles\nGeometry stays fixed",
        fillcolor="#dbeafe", color="#2563eb"];
  result [label="Placed fragments + completion / remainder\nGeneral pagination remains to be designed"];

  collection -> instantiate -> style -> validate -> fixed -> check -> compiled;
  collection -> sheets -> style;
  { rank=same; instantiate; sheets; }
  compiled -> flow [label="resolved destinations"];
  content -> flow [label="material"];
  flow -> result;
  { rank=same; compiled; content; }
}
