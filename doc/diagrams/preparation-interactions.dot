digraph PreparationInteractions {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.5, ranksep=0.5,
         fontname="Helvetica", fontsize=13,
         label="Implemented preparation ownership and layout reuse", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#64748b",
        fontname="Helvetica", fontsize=12, margin="0.18,0.12"];
  edge [color="#475569", fontname="Helvetica", fontsize=10];
  doc [label="content.Document\nImmutable normalized boxes + source/group index\nRegisterBank[content.Box] retains source only"];
  prepare [label="content.Prepare\nExtract detached GroupInput; preflight all groups\nPrepare once per group; atomic publication", fillcolor="#dbeafe"];
  backend [label="preparation/typography.Backend\nExplicit mapper + fresh stream services\nItemize and paragraph.Prepare", fillcolor="#dbeafe"];
  snapshot [label="PreparedSnapshot\nCopied source/paint/policy and group metadata\nNo executable handles", fillcolor="#dbeafe"];
  session [label="PreparationSession\nPrivate executable group handles\nSerialized operations and Close", fillcolor="#dbeafe"];
  invoke [label="MeasureIntrinsic / Layout\nValidate snapshot/session pair and qualified root\nReserve session; fresh invocation state"];
  core [label="CSS core\nIntrinsic bounds; used values; atomic interiors\nRealizedAtomicsView; ordinary flow geometry"];
  bridge [label="Typography bridge callbacks\nReuse paragraph.Prepared\nMeasureIntrinsic or Trial + Assemble"];
  result [label="Independent completed Result\nCopied CSS geometry + frozen paragraphs + source/paint\nUsable after session Close", fillcolor="#dbeafe"];
  fit [label="Proposed later work\nFinite-height box fitting and continuation\nPage selection + multi-channel commit", fillcolor="#fff7ed", color="#b45309"];
  doc -> prepare -> backend;
  prepare -> snapshot [label="on whole-document success"];
  backend -> session [label="owned handles"];
  snapshot -> invoke;
  session -> invoke [label="serialized reuse"];
  invoke -> core -> bridge;
  bridge -> core [label="width bounds / extent + placements", style=dashed];
  core -> result [label="whole-tree success"];
  bridge -> result [label="retained paragraph results"];
  result -> fit [style=dashed];
  { rank=same; snapshot; session; }
}
