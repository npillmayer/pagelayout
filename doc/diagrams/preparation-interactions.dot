digraph Layout {
  graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.4, ranksep=0.5,
         fontname="Helvetica", fontsize=14];
  node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#64748b",
        fontname="Helvetica", fontsize=12, margin="0.18,0.12"];
  edge [color="#475569", fontname="Helvetica", fontsize=10];
  graph [label="Geometry and typography cooperate under one session reservation", labelloc=t];
  call [label="MeasureIntrinsic / Layout / Fit\nQualified source + preparation + receiver"];
  reserve [label="content\nCheck coverage and reserve serialized session", fillcolor="#dbeafe"];
  core [label="CSS core\nFresh used values, margins, atomic interiors, edges"];
  bridge [label="Typography bridge\nBorrow retained paragraph handle\nMeasure, lay out or enumerate prefixes"];
  paragraph [label="typography / khipu\nExact checkpoint, manual carry, frozen glyph output"];
  result [label="Atomic result publication\nCopied geometry + immutable paragraphs + source coverage", fillcolor="#dcfce7"];
  call -> reserve -> core;
  core -> bridge [label="group + realized atomics"];
  bridge -> paragraph;
  paragraph -> bridge [label="prefixes and exact continuations", style=dashed];
  bridge -> core [label="bounds, placements, coverage", style=dashed];
  core -> result [label="successful checked composition"];
}
